<UserControl x:Class="GameCollections.Views.RuleBuilderView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameCollections.Views"
             xmlns:vm="clr-namespace:GameCollections.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DynamicRulesViewModel}"
             d:DesignHeight="400" d:DesignWidth="800">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameCollections;component/Views/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- One condition: field, operator, then the editor for that kind of value. -->
            <DataTemplate x:Key="ConditionTemplate" DataType="{x:Type vm:RuleConditionViewModel}">
                <StackPanel Margin="0,0,0,8">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource GcIconButton}" Height="30" Margin="8,0,0,0"
                                VerticalAlignment="Top"
                                Content="&#xeee4;"
                                Command="{Binding RemoveCommand}"
                                ToolTip="{DynamicResource LOCGameCollections_RuleRemoveCondition}"
                                AutomationProperties.Name="{DynamicResource LOCGameCollections_RuleRemoveCondition}" />
                        <ComboBox DockPanel.Dock="Left" Width="165" Height="30" VerticalAlignment="Top"
                                  ItemsSource="{x:Static vm:RuleConditionViewModel.Fields}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Field"
                                  SelectedValue="{Binding Field}"
                                  AutomationProperties.Name="{DynamicResource LOCGameCollections_RuleFieldLabel}" />
                        <ComboBox DockPanel.Dock="Left" Width="150" Height="30" Margin="8,0,0,0" VerticalAlignment="Top"
                                  ItemsSource="{Binding Operators}"
                                  DisplayMemberPath="Label"
                                  SelectedValuePath="Operator"
                                  SelectedValue="{Binding Operator}"
                                  AutomationProperties.Name="{DynamicResource LOCGameCollections_RuleOperatorLabel}" />

                        <Grid Margin="8,0,0,0">
                            <!-- Name -->
                            <TextBox Height="30" VerticalContentAlignment="Center"
                                     Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                     Visibility="{Binding ShowText, Converter={StaticResource BoolToVisibility}}"
                                     AutomationProperties.Name="{DynamicResource LOCGameCollections_RuleFieldName}" />

                            <!-- Dates -->
                            <DockPanel Visibility="{Binding ShowDate, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Width="110" Height="30" VerticalContentAlignment="Center"
                                         Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource LOCGameCollections_RuleDateHint}"
                                         AutomationProperties.Name="{DynamicResource LOCGameCollections_RuleDateHint}" />
                                <TextBlock Text="–" Style="{StaticResource GcMutedText}" VerticalAlignment="Center" Margin="8,0"
                                           Visibility="{Binding ShowDate2, Converter={StaticResource BoolToVisibility}}" />
                                <TextBox Width="110" Height="30" VerticalContentAlignment="Center"
                                         Text="{Binding Text2, UpdateSourceTrigger=PropertyChanged}"
                                         ToolTip="{DynamicResource LOCGameCollections_RuleDateHint}"
                                         Visibility="{Binding ShowDate2, Converter={StaticResource BoolToVisibility}}"
                                         AutomationProperties.Name="{DynamicResource LOCGameCollections_RuleDateHint}" />
                                <TextBlock Text="{DynamicResource LOCGameCollections_RuleDateHint}" Style="{StaticResource GcMutedText}"
                                           FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           TextTrimming="CharacterEllipsis" />
                            </DockPanel>

                            <!-- Numbers -->
                            <StackPanel Orientation="Horizontal" Visibility="{Binding ShowNumber, Converter={StaticResource BoolToVisibility}}">
                                <TextBox Width="80" Height="30" VerticalContentAlignment="Center"
                                         Text="{Binding NumberText, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{Binding UnitText}" />
                                <TextBlock Text="–" Style="{StaticResource GcMutedText}" VerticalAlignment="Center" Margin="8,0"
                                           Visibility="{Binding ShowNumber2, Converter={StaticResource BoolToVisibility}}" />
                                <TextBox Width="80" Height="30" VerticalContentAlignment="Center"
                                         Text="{Binding NumberText2, UpdateSourceTrigger=PropertyChanged}"
                                         Visibility="{Binding ShowNumber2, Converter={StaticResource BoolToVisibility}}"
                                         AutomationProperties.Name="{Binding UnitText}" />
                                <TextBlock Text="{Binding UnitText}" Style="{StaticResource GcMutedText}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </StackPanel>

                            <!-- Platforms, genres, tags etc.: removable chips plus a searchable picker. -->
                            <WrapPanel Orientation="Horizontal" Visibility="{Binding ShowItems, Converter={StaticResource BoolToVisibility}}">
                                <ToggleButton x:Name="PickerToggle" Height="30" Padding="10,0" Margin="0,0,6,4"
                                              Content="{Binding ItemsButtonText}"
                                              IsHitTestVisible="{Binding IsOpen, ElementName=PickerPopup, Converter={StaticResource InverseBool}}" />
                                <Popup x:Name="PickerPopup" StaysOpen="False" AllowsTransparency="True"
                                       IsOpen="{Binding IsChecked, ElementName=PickerToggle, Mode=TwoWay}"
                                       PlacementTarget="{Binding ElementName=PickerToggle}" Placement="Bottom"
                                       Opened="PickerPopup_Opened">
                                    <Border Width="300" Padding="8" Margin="0,2,0,0"
                                            Background="{DynamicResource PopupBackgroundBrush}"
                                            BorderBrush="{DynamicResource PopupBorderBrush}"
                                            BorderThickness="1">
                                        <DockPanel>
                                            <local:SearchBox DockPanel.Dock="Top" Height="30" Margin="0,0,0,6"
                                                             Text="{Binding OptionSearch}"
                                                             Placeholder="{DynamicResource LOCGameCollections_RuleSearchValues}" />
                                            <TextBlock DockPanel.Dock="Top" Text="{DynamicResource LOCGameCollections_RuleNoValues}"
                                                       Style="{StaticResource GcMutedText}" TextWrapping="Wrap" Margin="4"
                                                       Visibility="{Binding HasNoOptions, Converter={StaticResource BoolToVisibility}}" />
                                            <ListBox MaxHeight="260"
                                                     Style="{StaticResource GcPlainListBox}"
                                                     ItemsSource="{Binding OptionsView}"
                                                     IsSynchronizedWithCurrentItem="False"
                                                     SelectionMode="Single"
                                                     VirtualizingPanel.IsVirtualizing="True"
                                                     VirtualizingPanel.VirtualizationMode="Recycling">
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:RuleOptionItem}">
                                                        <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}" />
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>
                                        </DockPanel>
                                    </Border>
                                </Popup>
                                <ItemsControl ItemsSource="{Binding SelectedItems}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:RuleOptionItem}">
                                            <Border Background="{DynamicResource NormalBrush}" CornerRadius="3" Height="30" Margin="0,0,6,4" Padding="8,0,2,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" Style="{StaticResource GcText}" VerticalAlignment="Center" />
                                                    <Button Style="{StaticResource GcIconButton}" MinWidth="24" Padding="2" Margin="4,0,0,0"
                                                            BorderThickness="0" Background="Transparent" FontSize="11"
                                                            Content="&#xeee4;"
                                                            Command="{Binding RemoveCommand}"
                                                            ToolTip="{DynamicResource LOCGameCollections_ClearSearch}"
                                                            AutomationProperties.Name="{Binding Name}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </WrapPanel>
                        </Grid>
                    </DockPanel>
                    <TextBlock Text="{Binding ValueError}" Style="{StaticResource GcErrorText}" Margin="323,4,0,0"
                               Visibility="{Binding ValueError, Converter={StaticResource HasValueToVisibility}}" />
                </StackPanel>
            </DataTemplate>

            <!-- One block, with the AND/OR choice joining it to the blocks above. -->
            <DataTemplate x:Key="BlockTemplate" DataType="{x:Type vm:RuleBlockViewModel}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="12,8" HorizontalAlignment="Center"
                                Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVisibility}}">
                        <RadioButton GroupName="{Binding JoinGroupName}" IsChecked="{Binding IsAnd}" Margin="0,0,16,0"
                                     Content="{DynamicResource LOCGameCollections_RuleJoinAnd}" />
                        <RadioButton GroupName="{Binding JoinGroupName}" IsChecked="{Binding IsOr}"
                                     Content="{DynamicResource LOCGameCollections_RuleJoinOr}" />
                    </StackPanel>
                    <Border BorderBrush="{DynamicResource NormalBrush}" BorderThickness="1" CornerRadius="4" Padding="12,10">
                        <StackPanel>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Style="{StaticResource GcButton}"
                                        Command="{Binding RemoveCommand}"
                                        Visibility="{Binding IsFirst, Converter={StaticResource InverseBoolToVisibility}}"
                                        Content="{DynamicResource LOCGameCollections_RuleRemoveBlock}" />
                                <TextBlock Text="{Binding Title}" Style="{StaticResource GcItemTitleText}" VerticalAlignment="Center" />
                                <TextBlock Text="{DynamicResource LOCGameCollections_RuleBlockHint}" Style="{StaticResource GcMutedText}"
                                           FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" Margin="10,0,0,0" />
                            </DockPanel>
                            <ItemsControl ItemsSource="{Binding Conditions}" ItemTemplate="{StaticResource ConditionTemplate}" Focusable="False" />
                            <Button HorizontalAlignment="Left" Style="{StaticResource GcButton}" Command="{Binding AddConditionCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xefc2;" Style="{StaticResource GcGlyph}" Margin="0,0,6,0" />
                                    <TextBlock Text="{DynamicResource LOCGameCollections_RuleAddCondition}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel>
        <ItemsControl ItemsSource="{Binding Blocks}" ItemTemplate="{StaticResource BlockTemplate}" Focusable="False" />
        <DockPanel Margin="0,10,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource GcButton}" Command="{Binding AddBlockCommand}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="&#xefc2;" Style="{StaticResource GcGlyph}" Margin="0,0,6,0" />
                    <TextBlock Text="{DynamicResource LOCGameCollections_RuleAddBlock}" VerticalAlignment="Center" />
                </StackPanel>
            </Button>
            <TextBlock Text="{DynamicResource LOCGameCollections_RuleOrderHint}" Style="{StaticResource GcMutedText}"
                       FontSize="{DynamicResource FontSizeSmall}" TextWrapping="Wrap"
                       VerticalAlignment="Center" Margin="12,0,0,0" />
        </DockPanel>
    </StackPanel>
</UserControl>
