<UserControl x:Class="GameCollections.Views.CollectionDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GameCollections.Views"
             xmlns:vm="clr-namespace:GameCollections.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:CollectionDetailsViewModel}"
             d:DesignHeight="700" d:DesignWidth="900">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/GameCollections;component/Views/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <ContextMenu x:Key="GameContextMenu" x:Shared="False">
                <MenuItem Header="{Binding PlayActionText}" Command="{Binding PlayCommand}" FontWeight="SemiBold" InputGestureText="Enter" />
                <MenuItem Header="{DynamicResource LOCGameCollections_ShowInLibrary}" Command="{Binding ShowInLibraryCommand}" />
                <Separator />
                <MenuItem Header="{DynamicResource LOCGameCollections_MoveToTop}" Command="{Binding MoveToTopCommand}" />
                <MenuItem Header="{DynamicResource LOCGameCollections_MoveUp}" Command="{Binding MoveUpCommand}" InputGestureText="Alt+Up" />
                <MenuItem Header="{DynamicResource LOCGameCollections_MoveDown}" Command="{Binding MoveDownCommand}" InputGestureText="Alt+Down" />
                <MenuItem Header="{DynamicResource LOCGameCollections_MoveToBottom}" Command="{Binding MoveToBottomCommand}" />
                <Separator Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
                <MenuItem Header="{DynamicResource LOCGameCollections_RemoveFromCollection}" Command="{Binding RemoveCommand}" InputGestureText="Del"
                          Visibility="{Binding CanRemove, Converter={StaticResource BoolToVisibility}}" />
            </ContextMenu>

            <Style x:Key="GameContainerStyle" TargetType="ListBoxItem" BasedOn="{StaticResource {x:Type ListBoxItem}}">
                <Setter Property="ContextMenu" Value="{StaticResource GameContextMenu}" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="Padding" Value="6" />
                <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
                <Setter Property="ToolTip" Value="{Binding Name}" />
                <EventSetter Event="MouseDoubleClick" Handler="GameItem_MouseDoubleClick" />
                <EventSetter Event="Loaded" Handler="GameItem_Loaded" />
                <EventSetter Event="PreviewMouseLeftButtonDown" Handler="GameItem_PreviewMouseLeftButtonDown" />
                <EventSetter Event="PreviewMouseLeftButtonUp" Handler="GameItem_PreviewMouseLeftButtonUp" />
                <EventSetter Event="PreviewMouseMove" Handler="GameItem_PreviewMouseMove" />
            </Style>

            <DataTemplate x:Key="GameTemplate" DataType="{x:Type vm:CollectionGameViewModel}">
                <!-- Sized by the card size slider on the page. -->
                <StackPanel Width="{Binding DataContext.CardWidth, RelativeSource={RelativeSource AncestorType=ListBox}}">
                    <Grid Height="{Binding DataContext.CardHeight, RelativeSource={RelativeSource AncestorType=ListBox}}">
                        <local:PosterImage GlyphSize="40" Glyph="&#xea30;" Source="{Binding Cover}" />
                        <!-- Dim games that are not installed, as Playnite's own grid does. -->
                        <Border Background="#80000000" CornerRadius="4" IsHitTestVisible="False"
                                Visibility="{Binding IsInstalled, Converter={StaticResource InverseBoolToVisibility}}" />
                    </Grid>
                    <TextBlock Text="{Binding Name}" Style="{StaticResource GcText}"
                               TextTrimming="CharacterEllipsis" TextWrapping="NoWrap"
                               Margin="0,6,0,0" />
                </StackPanel>
            </DataTemplate>
        </ResourceDictionary>
    </UserControl.Resources>

    <DockPanel Margin="20,10,20,0">
        <!-- Back navigation -->
        <Button DockPanel.Dock="Top" HorizontalAlignment="Left" Style="{StaticResource GcButton}"
                Visibility="{Binding IsInWindow, Converter={StaticResource InverseBoolToVisibility}}"
                Command="{Binding BackCommand}"
                AutomationProperties.Name="{DynamicResource LOCGameCollections_BackToCollections}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="&#xea5c;" Style="{StaticResource GcGlyph}" Margin="0,0,6,0" />
                <TextBlock Text="{DynamicResource LOCGameCollections_BackToCollections}" VerticalAlignment="Center" />
            </StackPanel>
        </Button>

        <!-- Collection header -->
        <!-- Collapsing it leaves only the title, game count and dynamic badge. -->
        <Grid DockPanel.Dock="Top" Margin="0,15,0,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <local:PosterImage Width="140" Height="210" GlyphSize="52" Source="{Binding Header.Poster}" VerticalAlignment="Top"
                               Margin="0,0,20,0"
                               Visibility="{Binding IsHeaderCollapsed, Converter={StaticResource InverseBoolToVisibility}}" />
            <Button Grid.Column="2" Style="{StaticResource GcIconButton}" VerticalAlignment="Top" Margin="10,0,0,0"
                    Content="{Binding HeaderToggleGlyph}"
                    Command="{Binding ToggleHeaderCommand}"
                    ToolTip="{Binding HeaderToggleTooltip}"
                    AutomationProperties.Name="{Binding HeaderToggleTooltip}" />
            <StackPanel Grid.Column="1">
                <TextBlock Text="{Binding Header.Title}" Style="{StaticResource GcPageTitleText}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                    <StackPanel Orientation="Horizontal"
                                Visibility="{Binding IsHeaderCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                        <TextBlock Text="&#xf000;" Style="{StaticResource GcGlyph}"
                                   Foreground="{DynamicResource GlyphBrush}" Margin="0,0,5,0" />
                        <TextBlock Text="{Binding Header.RatingText}" Style="{StaticResource GcText}" />
                        <TextBlock Text="•" Style="{StaticResource GcMutedText}" Margin="10,0" />
                    </StackPanel>
                    <TextBlock Text="{Binding Header.GameCountText}" Style="{StaticResource GcMutedText}" />
                    <Border Style="{StaticResource GcBadge}" Margin="10,0,0,0"
                            Visibility="{Binding IsDynamic, Converter={StaticResource BoolToVisibility}}">
                        <TextBlock Text="{DynamicResource LOCGameCollections_DynamicBadge}" Style="{StaticResource GcBadgeText}" />
                    </Border>
                </StackPanel>
                <StackPanel Visibility="{Binding IsHeaderCollapsed, Converter={StaticResource InverseBoolToVisibility}}">
                <TextBlock Text="{Binding RulesSummary}" Style="{StaticResource GcMutedText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"
                           Visibility="{Binding RulesSummary, Converter={StaticResource HasValueToVisibility}}" />
                <ScrollViewer MaxHeight="96" Margin="0,10,0,0" VerticalScrollBarVisibility="Auto"
                              Visibility="{Binding Header.HasDescription, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding Header.Description}" Style="{StaticResource GcMutedText}" TextWrapping="Wrap" />
                </ScrollViewer>
                <WrapPanel Orientation="Horizontal" Margin="0,14,0,0">
                    <Button Style="{StaticResource GcButton}" Command="{Binding Header.EditCommand}" Margin="0,0,8,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xec55;" Style="{StaticResource GcGlyph}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource LOCGameCollections_EditCollection}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GcButton}" Command="{Binding RefreshCommand}" Margin="0,0,8,0"
                            ToolTip="{DynamicResource LOCGameCollections_RefreshNowTooltip}"
                            Content="{DynamicResource LOCGameCollections_RefreshNow}"
                            Visibility="{Binding IsDynamic, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource GcButton}" Command="{Binding OpenInCollectionsCommand}" Margin="0,0,8,0"
                            ToolTip="{DynamicResource LOCGameCollections_OpenInCollectionsTooltip}"
                            Content="{DynamicResource LOCGameCollections_OpenInCollections}"
                            Visibility="{Binding IsInWindow, Converter={StaticResource BoolToVisibility}}" />
                    <Button Style="{StaticResource GcButton}" Command="{Binding ShowAllInLibraryCommand}" Margin="0,0,8,0"
                            Visibility="{Binding IsInWindow, Converter={StaticResource InverseBoolToVisibility}}"
                            ToolTip="{DynamicResource LOCGameCollections_ShowAllInLibraryTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xef24;" Style="{StaticResource GcGlyph}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource LOCGameCollections_ShowAllInLibrary}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource GcButton}" Command="{Binding Header.DeleteCommand}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xec53;" Style="{StaticResource GcGlyph}" Margin="0,0,6,0" />
                            <TextBlock Text="{DynamicResource LOCGameCollections_DeleteCollection}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Toolbar: search, sort, group, filter. The search box and buttons take the dropdowns'
             height, which comes from the theme, so the row lines up in any theme. -->
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
            <TextBlock DockPanel.Dock="Right" Text="{Binding VisibleCountText}" Style="{StaticResource GcMutedText}"
                       VerticalAlignment="Top" Margin="16,8,0,0" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top" Margin="16,0,0,0"
                        Height="{Binding ActualHeight, ElementName=SortCombo}">
                <TextBlock Text="{DynamicResource LOCGameCollections_CardSize}" Style="{StaticResource GcText}"
                           VerticalAlignment="Center" Margin="0,0,8,0" />
                <Slider Width="110" VerticalAlignment="Center"
                        Minimum="{x:Static vm:CollectionDetailsViewModel.MinCardWidth}"
                        Maximum="{x:Static vm:CollectionDetailsViewModel.MaxCardWidth}"
                        SmallChange="10" LargeChange="30"
                        Value="{Binding CardWidth}"
                        ToolTip="{DynamicResource LOCGameCollections_CardSize}"
                        AutomationProperties.Name="{DynamicResource LOCGameCollections_CardSize}" />
            </StackPanel>
            <WrapPanel Orientation="Horizontal">
            <local:SearchBox Width="240" Margin="0,0,0,4" VerticalAlignment="Center"
                             Height="{Binding ActualHeight, ElementName=SortCombo}"
                             Text="{Binding SearchText}"
                             Placeholder="{DynamicResource LOCGameCollections_SearchGames}" />
            <TextBlock Text="{DynamicResource LOCGameCollections_SortBy}" Style="{StaticResource GcText}"
                       VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox x:Name="SortCombo" MinWidth="150" VerticalAlignment="Center"
                      ItemsSource="{Binding SortOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Field"
                      SelectedValue="{Binding SortField}"
                      AutomationProperties.Name="{DynamicResource LOCGameCollections_SortBy}" />
            <Button Style="{StaticResource GcIconButton}" Margin="5,0,0,0"
                    Height="{Binding ActualHeight, ElementName=SortCombo}"
                    Content="{Binding SortDirectionGlyph}"
                    Command="{Binding ToggleSortDirectionCommand}"
                    ToolTip="{Binding SortDirectionTooltip}"
                    AutomationProperties.Name="{Binding SortDirectionTooltip}" />
            <TextBlock Text="{DynamicResource LOCGameCollections_GroupBy}" Style="{StaticResource GcText}"
                       VerticalAlignment="Center" Margin="16,0,8,0" />
            <ComboBox MinWidth="130" VerticalAlignment="Center"
                      ItemsSource="{Binding GroupOptions}"
                      DisplayMemberPath="Label"
                      SelectedValuePath="Field"
                      SelectedValue="{Binding GroupBy}"
                      AutomationProperties.Name="{DynamicResource LOCGameCollections_GroupBy}" />
            <Button Style="{StaticResource GcButton}" Margin="5,0,0,0" Padding="10,0"
                    Height="{Binding ActualHeight, ElementName=SortCombo}"
                    Content="{Binding ToggleAllGroupsText}"
                    Command="{Binding ToggleAllGroupsCommand}"
                    Visibility="{Binding IsGrouped, Converter={StaticResource BoolToVisibility}}" />
            <CheckBox VerticalAlignment="Center" Margin="16,0,0,0"
                      IsChecked="{Binding InstalledOnly}"
                      Content="{DynamicResource LOCGameCollections_InstalledOnly}" />
            <TextBlock Text="{Binding ReorderHint}" Style="{StaticResource GcMutedText}"
                       FontSize="{DynamicResource FontSizeSmall}" VerticalAlignment="Center" Margin="16,0,0,0" />
            </WrapPanel>
        </DockPanel>

        <Grid>
            <ListBox x:Name="GamesList"
                     Style="{StaticResource GcPlainListBox}"
                     ItemsSource="{Binding GamesView}"
                     IsSynchronizedWithCurrentItem="False"
                     SelectionMode="Extended"
                     ItemTemplate="{StaticResource GameTemplate}"
                     ItemContainerStyle="{StaticResource GameContainerStyle}"
                     ScrollViewer.CanContentScroll="False"
                     KeyDown="GamesList_KeyDown"
                     PreviewKeyDown="GamesList_PreviewKeyDown"
                     AllowDrop="True"
                     DragOver="GamesList_DragOver"
                     DragLeave="GamesList_DragLeave"
                     Drop="GamesList_Drop"
                     SizeChanged="GamesList_SizeChanged"
                     AutomationProperties.Name="{Binding Header.Title}">
                <ListBox.GroupStyle>
                    <!-- Each group is an expander so it can be collapsed. Its state is kept by the
                         view model and applied in GroupExpander_Loaded. -->
                    <GroupStyle>
                        <GroupStyle.ContainerStyle>
                            <Style TargetType="GroupItem">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="GroupItem">
                                            <Expander IsExpanded="True" Margin="0,0,0,8"
                                                      Loaded="GroupExpander_Loaded"
                                                      Expanded="GroupExpander_Toggled"
                                                      Collapsed="GroupExpander_Toggled">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                                        <TextBlock Text="{Binding Name}" Style="{StaticResource GcItemTitleText}"
                                                                   FontSize="{DynamicResource FontSizeLarge}" />
                                                        <TextBlock Text="{Binding ItemCount}" Style="{StaticResource GcMutedText}"
                                                                   VerticalAlignment="Center" Margin="8,0,0,0" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <ItemsPresenter Margin="0,8,0,0" />
                                            </Expander>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupStyle.ContainerStyle>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" Margin="0,0,0,10" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>

            <!-- Shows where dragged games will land. -->
            <Canvas IsHitTestVisible="False" ClipToBounds="True">
                <Rectangle x:Name="DropIndicator" Width="3" Fill="{DynamicResource GlyphBrush}" Visibility="Collapsed" />
            </Canvas>

            <!-- Empty collection -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0" MaxWidth="420"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                <TextBlock Text="{Binding EmptyTitle}" Style="{StaticResource GcText}"
                           FontSize="{DynamicResource FontSizeLarge}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding EmptyDescription}" Style="{StaticResource GcMutedText}"
                           TextWrapping="Wrap" TextAlignment="Center" Margin="0,8,0,0" />
            </StackPanel>

            <TextBlock Text="{DynamicResource LOCGameCollections_NoGamesMatch}" Style="{StaticResource GcMutedText}"
                       HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,40,0,0"
                       Visibility="{Binding HasNoResults, Converter={StaticResource BoolToVisibility}}" />
        </Grid>
    </DockPanel>
</UserControl>
