<UserControl x:Class="GameCollections.Settings.GameCollectionsSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="200" d:DesignWidth="600">
    <StackPanel Margin="20">
        <CheckBox IsChecked="{Binding Settings.AddDetailsListToAnyTheme}"
                  Content="{DynamicResource LOCGameCollections_SettingAddListToAnyTheme}" />
        <TextBlock Style="{StaticResource BaseTextBlockStyle}"
                   Foreground="{DynamicResource TextBrushDarker}"
                   TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="{DynamicResource LOCGameCollections_SettingAddListToAnyThemeHint}" />
        <CheckBox IsChecked="{Binding Settings.UseThemeSpecificPlacement}"
                  IsEnabled="{Binding Settings.AddDetailsListToAnyTheme}"
                  Content="{DynamicResource LOCGameCollections_SettingThemeSpecificPlacement}" />
        <TextBlock Style="{StaticResource BaseTextBlockStyle}"
                   Foreground="{DynamicResource TextBrushDarker}"
                   TextWrapping="Wrap" Margin="0,4,0,16"
                   Text="{DynamicResource LOCGameCollections_SettingThemeSpecificPlacementHint}" />
        <CheckBox IsChecked="{Binding Settings.ShowDynamicCollectionsInDetails}"
                  Content="{DynamicResource LOCGameCollections_SettingShowDynamicInDetails}" />
        <TextBlock Style="{StaticResource BaseTextBlockStyle}"
                   Foreground="{DynamicResource TextBrushDarker}"
                   TextWrapping="Wrap" Margin="0,4,0,0"
                   Text="{DynamicResource LOCGameCollections_SettingShowDynamicInDetailsHint}" />
    </StackPanel>
</UserControl>
